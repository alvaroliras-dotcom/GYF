RewriteRule ^auditoria-gratis/?$ https://elgordoyelflaco.es/auditoria-seo-local/ [L,R=301]
RewriteRule ^servicios/diseno-web/?$ https://elgordoyelflaco.es/diseno-web/ [L,R=301]
RewriteRule ^servicios/diseno-web/webs-para-conversion/?$ https://elgordoyelflaco.es/diseno-web/ [L,R=301]
RewriteRule ^servicios/diseno-web/responsive-velocidad/?$ https://elgordoyelflaco.es/diseno-web/ [L,R=301]
RewriteRule ^servicios/diseno-web/integraciones-analitica-ficha-google/?$ https://elgordoyelflaco.es/diseno-web/ [L,R=301]
RewriteRule ^servicios/diseno-web/arquitectura-web-seo/?$ https://elgordoyelflaco.es/diseno-web/ [L,R=301]
RewriteRule ^servicios/desarrollo-paginas-web/?$ https://elgordoyelflaco.es/diseno-web/ [L,R=301]
RewriteRule ^servicios/mantenimiento/?$ https://elgordoyelflaco.es/diseno-web/ [L,R=301]
RewriteRule ^servicios/google-ads/?$ https://elgordoyelflaco.es/google-ads/ [L,R=301]
RewriteRule ^servicios/google-ads/google-ads-local/?$ https://elgordoyelflaco.es/google-ads/ [L,R=301]
RewriteRule ^servicios/google-ads/paginas-aterrizaje-conversion/?$ https://elgordoyelflaco.es/google-ads/ [L,R=301]
RewriteRule ^servicios/google-ads/display-geolocalizado/?$ https://elgordoyelflaco.es/google-ads/ [L,R=301]
RewriteRule ^servicios/google-ads/anuncios-en-maps-youtube/?$ https://elgordoyelflaco.es/google-ads/ [L,R=301]
RewriteRule ^servicios/diseno-grafico/?$ https://elgordoyelflaco.es/diseno-grafico/ [L,R=301]
RewriteRule ^servicios/diseno-grafico/imagen-marca-branding/?$ https://elgordoyelflaco.es/diseno-grafico/ [L,R=301]
RewriteRule ^servicios/diseno-grafico/diseno-grafico-para-web-y-redes-sociales/?$ https://elgordoyelflaco.es/diseno-grafico/ [L,R=301]
RewriteRule ^servicios/diseno-grafico/packaging-etiquetado-producto/?$ https://elgordoyelflaco.es/diseno-grafico/ [L,R=301]
